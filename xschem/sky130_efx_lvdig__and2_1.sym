G {}
K {type=primitive
function2="0 1 &"
format="@name @pinlist @VGND @VNB @VPB @VPWR @symname"
template="name=x1 VGND=VGND VNB=VNB VPB=VPB VPWR=VPWR "
extra="VGND VNB VPB VPWR"
highlight=true
}
