K {type=primitive
format="@name @VGND @VPB @VPWR @prefix\\\\tapvgnd_2"
template="name=x1 VGND=VGND VPB=VPB VPWR=VPWR prefix=sky130_efx_lvdig__ "
extra="VGND VPB VPWR prefix"
verilogprefix=sky130_efx_lvdig__
highlight=true}
T {@symname} 0 -6 0 0 0.3 0.3 {hcenter=true}
T {@name} 75 -22 0 0 0.2 0.2 {}
L 4 -70 -10 70 -10 {}
L 4 -70 10 70 10 {}
L 4 -70 -10 -70 10 {}
L 4 70 -10 70 10 {}
