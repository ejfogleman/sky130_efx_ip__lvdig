# xschem/ngspice/magic
untitled*
*.log
*.ps
*.svg
*.raw
*.out
*.err
*.ext
*.sim
*.nodes
*.drc
*.cif
*.spice
*.png
*.pdf
*.eps
*.csv
# scripts/check_sch.sh output and scratch (rewritten each run)
lvs/check/
# Library netlists, regenerated by make libcdl / make libspice (folders kept by .gitkeep)
cdl/*.cdl
# Layouts moved aside as unused (mag/README.md section 6), e.g. mag/unused/
unused/

# Exception: Allow png/pdf/eps in doc directory
!doc/*.png
!doc/*.pdf
!doc/*.eps

# Simulation directory
sim/*.txt
!sim/requirements.txt
# Testbench netlists in sim/ are tracked; *.raw and *.log above stay ignored
!sim/**/*.spice

# General
*.bak*
*.tmp
*.swp
*.swo
*.save
*~
.venv

# Python cache
__pycache__/
*.pyc

# Claude Code per-user settings (shared ones would go in .claude/settings.json)
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

